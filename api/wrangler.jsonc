{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tideweave-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tideweave-dev",
      "database_id": "faaebc44-a846-4918-96b4-5a57a26d02bf",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_READS",
      "namespace_id": "143001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "AUTHENTICATION",
      "namespace_id": "143002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "DISCOVERY_REQUESTS",
      "namespace_id": "143003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "WALLET_READS",
      "namespace_id": "143004",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "WALLET_MUTATIONS",
      "namespace_id": "143005",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "RECONCILIATION",
      "namespace_id": "143006",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "services": [
    {
      "binding": "SIGNER",
      "service": "tideweave-signer",
    },
    {
      "binding": "INDEXER",
      "service": "tideweave-indexer",
    },
    {
      "binding": "AUTOMATION",
      "service": "tideweave-automation",
    },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.2 },
}
