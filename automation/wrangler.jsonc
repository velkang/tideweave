{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tideweave-automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "vars": { "AGENT_DAILY_CALL_LIMIT": "100" },
  "durable_objects": {
    "bindings": [{ "name": "RUNS", "class_name": "WalletAutomation" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WalletAutomation"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tideweave-dev",
      "database_id": "faaebc44-a846-4918-96b4-5a57a26d02bf",
      "migrations_dir": "../api/migrations",
    },
  ],
  "services": [
    {
      "binding": "API",
      "service": "tideweave-api",
    },
  ],
  "observability": { "enabled": true },
}
